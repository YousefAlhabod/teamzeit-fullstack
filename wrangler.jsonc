{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamzeit-app",
  "account_id": "9be816f99da25a8e3e7060c22f5fdb26",
  "workers_dev": true,
  "routes": [{"pattern":"teamzeit.yousef-alhabod.de","custom_domain":true}],
  "vars": {"APP_ORIGIN":"https://teamzeit.yousef-alhabod.de","REGISTRATION_ENABLED":"true","MAIL_FROM":"TeamZeit <noreply@mail.teamzeit.yousef-alhabod.de>"},
  "triggers": {"crons":["17 3 * * *"]},
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teamzeit-production",
      "database_id": "0b612ef0-81b5-45ba-9c17-a4dbf9f288e7",
      "jurisdiction": "eu",
      "migrations_dir": "migrations"
    }
  ]
}
